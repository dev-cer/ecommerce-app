# Image runtime untuk CI (Jenkins/Kaniko): hanya mengemas binary yang sudah dibangun & dites di container
# rust:1.98-slim-trixie pada stage "Lint, Test & Build" (glibc sama dengan runtime trixie). Tanpa kompilasi
# dan tanpa unduhan crate, jadi stage image selesai dalam hitungan detik. Build lokal tetap memakai Dockerfile.
FROM debian:trixie-slim
WORKDIR /app
RUN useradd --system --uid 10001 app
COPY dist/app-repo /app/ecommerce-service
USER app

# Diisi CI (Jenkins) dengan tag image, tampil di /health dan footer storefront.
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION PORT=8080 RUST_LOG=info
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/$PORT && printf 'GET /health HTTP/1.0\\r\\n\\r\\n' >&3 && grep -q ok <&3"]
CMD ["./ecommerce-service"]
